# Option A: Product Hunt developer token
#   https://www.producthunt.com/v2/oauth/applications -> your app -> "Create Token"
PH_API_TOKEN=

# Option B: app API Key / Secret -> run `bun scripts/get-token.ts` to mint PH_API_TOKEN
PH_CLIENT_ID=
PH_CLIENT_SECRET=

# Optional overrides
PH_API_URL=https://api.producthunt.com/v2/api/graphql
PH_WEB_URL=https://www.producthunt.com
# Optional WAF allowlist header for E2E traffic, provided by infra (JSON)
PH_E2E_EXTRA_HEADERS=
